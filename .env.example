# Configuration Tekki Services SaaS - Paiements Wave & Orange Money

# Port du serveur Express (défaut : 3000)
PORT=3000

# Base de données SQLite locale ou chemin fichier (défaut: data/tekki.db)
DATABASE_URL="file:./data/tekki.db"

# Numéro Wave / Orange Money officiel du propriétaire
OWNER_PHONE="+221784243420"
OWNER_EMAIL="almamydiakhite12@gmail.com"

# Wave Business API Sénégal (API directe Wave ou agrégateur agréé)
# Clé API Wave Business (fournie par Wave Business Developer Portal)
WAVE_API_KEY=""
# Clé secrète Wave
WAVE_SECRET_KEY=""
# Secret du webhook Wave pour valider la signature HMAC-SHA256
WAVE_WEBHOOK_SECRET=""
# Mode Wave : 'sandbox' ou 'production'
WAVE_ENVIRONMENT="sandbox"

# Orange Money Sénégal (API Orange Developer Web Payment / MEA OM API)
# Client ID de l'application Orange Developer
ORANGE_MONEY_CLIENT_ID=""
# Client Secret Orange Developer
ORANGE_MONEY_CLIENT_SECRET=""
# Merchant Key ou Code Marchand Orange Money (compte marchand +221 78 424 34 20)
ORANGE_MONEY_MERCHANT_KEY=""
# Secret de vérification des notifications webhook Orange Money
ORANGE_MONEY_WEBHOOK_SECRET=""
# Mode Orange Money : 'sandbox' ou 'production'
ORANGE_MONEY_ENVIRONMENT="sandbox"

# Clé secrète générale pour webhooks et callbacks
PAYMENT_WEBHOOK_SECRET="change-this-to-a-very-secure-random-secret"

# Secrets de sessions et tokens administrateur (chiffrement et signature)
SESSION_SECRET="change-this-session-secret-min-32-chars-long"
JWT_SECRET="change-this-jwt-secret-min-32-chars-long"

# Email de l'administrateur propriétaire par défaut (utilisé lors de l'initialisation sécurisée)
ADMIN_EMAIL="almamydiakhite12@gmail.com"

# URL publique de l'application (pour webhooks et redirections)
APP_URL="http://localhost:3000"
